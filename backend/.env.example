# LifeLoan Backend Environment Variables (Template)
# Copy this file to .env and set your real secrets. Do NOT commit .env to version control.

# Google Gemini API Key (Server-side only for AI Financial Advisor & Recovery Planner)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key for authenticating users
SECRET_KEY=your_super_secret_jwt_key_here
DATABASE_URL=your_database_url_here